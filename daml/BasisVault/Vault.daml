-- BasisVault core: a privacy-preserving, auditable delta-neutral yield vault.
--
-- Roles (the institutional-grade story judges reward):
--   operator  — custodian / vault operator. SOLE signatory of vault state.
--   manager   — off-chain strategy engine; PROPOSES rebalances, cannot mint.
--   auditor   — regulator / fund auditor; OBSERVES everything.
--   investor  — holds shares; sees ONLY their own holding.
--
-- Privacy (Canton need-to-know disclosure, the Confimarket-winning axis):
--   Vault        → operator (sig), manager + auditor (obs)
--   ShareHolding → operator (sig), the one investor + auditor (obs)
--   ⇒ a counterparty / other investor sees NOTHING. Proven in Test.VaultTest.
module BasisVault.Vault where

import BasisVault.Types

-- Price per share; bootstraps to 1.0 when the vault is empty. Top-level so it
-- is callable from any choice (a template-body `let` can't carry an inline type
-- signature, and we want this shared by mint + burn).
pricePerShare : Decimal -> Decimal -> Decimal
pricePerShare assets shares = if shares > 0.0 then assets / shares else 1.0

template Vault
  with
    operator : Party
    manager : Party
    auditor : Party
    underlying : Underlying
    totalAssets : Decimal   -- NAV in quote units
    totalShares : Decimal
  where
    signatory operator
    observer manager, auditor
    ensure totalAssets >= 0.0 && totalShares >= 0.0

    -- Operator mints shares to an investor for a deposit of `amount`.
    choice Vault_MintShares : (ContractId Vault, ContractId ShareHolding)
      with
        investor : Party
        amount : Decimal
      controller operator
      do
        let pps = pricePerShare totalAssets totalShares
        let newShares = amount / pps
        sh <- create ShareHolding with
          operator; investor; auditor; shares = newShares
        v <- create this with
          totalAssets = totalAssets + amount
          totalShares = totalShares + newShares
        pure (v, sh)

    -- Operator burns an investor's holding on redemption, returning its NAV.
    choice Vault_BurnShares : (ContractId Vault, Decimal)
      with
        holdingCid : ContractId ShareHolding
      controller operator
      do
        sh <- fetch holdingCid
        archive holdingCid
        let pps = pricePerShare totalAssets totalShares
        let amount = sh.shares * pps
        v <- create this with
          totalAssets = totalAssets - amount
          totalShares = totalShares - sh.shares
        pure (v, amount)

    -- Manager proposes a delta-neutral rebalance; operator approves (Day-2:
    -- approval executes the legs via PerpSwap / Helvet adapters).
    nonconsuming choice Vault_ProposeRebalance : ContractId RebalanceProposal
      with
        plan : RebalancePlan
      controller manager
      do
        create RebalanceProposal with
          operator; manager; auditor; vaultCid = self; plan

-- An investor's claim on the vault. Visible only to that investor + the auditor.
template ShareHolding
  with
    operator : Party
    investor : Party
    auditor : Party
    shares : Decimal
  where
    signatory operator
    observer investor, auditor
    ensure shares > 0.0

    -- Investor initiates a redemption (operator settles it).
    nonconsuming choice ShareHolding_RequestRedeem : ContractId RedeemRequest
      controller investor
      do
        create RedeemRequest with
          operator; investor; auditor; holdingCid = self

-- Investor-signed deposit request; operator accepts to mint shares.
template DepositRequest
  with
    operator : Party
    investor : Party
    amount : Decimal
    vaultCid : ContractId Vault
  where
    signatory investor
    observer operator
    ensure amount > 0.0

    choice DepositRequest_Accept : (ContractId Vault, ContractId ShareHolding)
      controller operator
      do exercise vaultCid Vault_MintShares with investor; amount

    choice DepositRequest_Reject : ()
      controller operator
      do pure ()

-- Investor-signed redeem request; operator accepts against the live vault.
template RedeemRequest
  with
    operator : Party
    investor : Party
    auditor : Party
    holdingCid : ContractId ShareHolding
  where
    signatory investor
    observer operator

    choice RedeemRequest_Accept : (ContractId Vault, Decimal)
      with
        vaultCid : ContractId Vault
      controller operator
      do exercise vaultCid Vault_BurnShares with holdingCid

-- A manager-proposed rebalance awaiting operator approval.
template RebalanceProposal
  with
    operator : Party
    manager : Party
    auditor : Party
    vaultCid : ContractId Vault
    plan : RebalancePlan
  where
    signatory manager
    observer operator, auditor

    -- Day-2: approval executes short PerpSwap + long Helvet legs via adapters.
    choice RebalanceProposal_Approve : ()
      controller operator
      do pure ()  -- TODO Day-2: call venue adapters, assert net delta ≈ 0

    choice RebalanceProposal_Reject : ()
      controller operator
      do pure ()
