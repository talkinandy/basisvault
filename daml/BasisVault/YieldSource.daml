-- RWA yield sources (the hero) + their rate oracle.
--
-- Canton's flagship use case is tokenized RWA — Treasury repo, money-market
-- funds, credit. BasisVault allocates vault capital across these sources and
-- earns their (oracle-anchored) yield. Sources that aren't live on Canton yet
-- are modelled here behind the same seam, so real tokenized-RWA assets drop in
-- unchanged as the infrastructure ships.
--
-- This module carries the RWA-track end-to-end workflow:
--   create (approve) -> update status (accrue) -> fulfill (close) -> audit
-- with need-to-know privacy (auditor sees all, investor own, outsider nothing).
module BasisVault.YieldSource where

import BasisVault.Types

-- Oracle / rate-feed anchored annualized yield for a source (repo rate, MMF
-- yield). Allocations mark to THIS, never to a guessed number — the honesty +
-- oracle discipline the judges look for. Oracle signs; operator observes so it
-- can mark allocations.
template RateFeed
  with
    oracle : Party
    operator : Party
    kind : YieldSourceKind
    asset : Text
    annualizedRate : Decimal   -- e.g. 0.0525 == 5.25%/yr
  where
    signatory oracle
    observer operator
    ensure annualizedRate >= 0.0

-- Capital deployed to a tokenized-RWA yield source. `accrued` is REALIZED yield
-- marked at the rate feed — never projected (no phantom yield). signatory
-- operator (custodian holds it); manager + auditor observe.
template Allocation
  with
    operator : Party
    manager : Party
    auditor : Party
    kind : YieldSourceKind
    asset : Text
    principal : Decimal        -- working capital deployed to the source
    annualizedRate : Decimal   -- rate at open / last accrual (oracle-anchored)
    accrued : Decimal          -- realized yield so far
  where
    signatory operator
    observer manager, auditor
    ensure principal >= 0.0 && accrued >= 0.0
