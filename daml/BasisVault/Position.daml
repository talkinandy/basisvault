-- A live delta-neutral position, created when the operator approves a
-- RebalanceProposal and the venue adapters (PerpSwap short + Helvet long) fill.
-- Wired into Vault.RebalanceProposal_Approve (Day-2).
module BasisVault.Position where

import BasisVault.Types
import BasisVault.Venue

-- net delta of an equal-notional hedge: long notional minus short notional.
-- ≈ 0 by construction; the approve choice guards on this.
netDelta : Decimal -> Decimal -> Decimal
netDelta longNotional shortNotional = longNotional - shortNotional

template DeltaNeutralPosition
  with
    operator : Party
    manager : Party
    auditor : Party
    vaultId : Text                   -- bound to the vault that opened it
    underlying : Underlying
    shortLeg : ContractId VenueLeg   -- PerpSwap leg (receives funding)
    longLeg : ContractId VenueLeg    -- Helvet/spot leg (cancels price)
    shortNotional : Decimal
    longNotional : Decimal
    markPrice : Decimal              -- oracle mark at open (not last-trade)
    collateralAsset : Text          -- what margins the short ("" = plain stablecoin)
    collateralRate : Decimal        -- its base yield, earned WHILE it margins the carry
    fundingAccrued : Decimal        -- REALIZED funding credited to NAV so far
  where
    signatory operator
    observer manager, auditor
    -- equal-notional hedge ⇒ net delta ≈ 0
    ensure shortNotional >= 0.0 && longNotional >= 0.0 && fundingAccrued >= 0.0

    -- Unwind both legs (e.g. when trailing funding turns negative — the sign
    -- guard, mirroring the BasisYield cash-carry auto-unwind). Consuming, so the
    -- position is closed once.
    choice DeltaNeutralPosition_Unwind : ()
      controller operator
      do
        exercise shortLeg VenueLeg_Close
        exercise longLeg VenueLeg_Close
        pure ()
