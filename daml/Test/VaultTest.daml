-- Day-1 acceptance: deposit/redeem accounting + the privacy guarantee.
-- Run with `daml test` (or `daml start`).
module Test.VaultTest where

import Daml.Script
import DA.Assert ((===))
import BasisVault.Vault
import BasisVault.Venue
import BasisVault.Position
import BasisVault.YieldSource
import BasisVault.Types

data Parties = Parties
  with
    operator : Party
    manager : Party
    auditor : Party
    oracle : Party
    alice : Party
    bob : Party
    mallory : Party

setupParties : Script Parties
setupParties = do
  operator <- allocateParty "Operator"
  manager  <- allocateParty "Manager"
  auditor  <- allocateParty "Auditor"
  oracle   <- allocateParty "Oracle"
  alice    <- allocateParty "AliceInvestor"
  bob      <- allocateParty "BobInvestor"
  mallory  <- allocateParty "MalloryOutsider"
  pure Parties with ..

-- Deposit mints shares 1:1 on a fresh vault, and burns return NAV.
testDepositRedeem : Script ()
testDepositRedeem = do
  p <- setupParties
  vault <- submit p.operator do
    createCmd Vault with
      operator = p.operator; manager = p.manager; auditor = p.auditor
      vaultId = "vault-main"; underlying = CBTC; totalAssets = 0.0; totalShares = 0.0

  -- Alice deposits 1000; operator accepts.
  depReq <- submit p.alice do
    createCmd DepositRequest with
      operator = p.operator; investor = p.alice; amount = 1000.0; vaultCid = vault
  (vault2, aliceShares) <- submit p.operator do
    exerciseCmd depReq DepositRequest_Accept

  -- pps bootstrapped at 1.0 ⇒ 1000 shares.
  optSh <- queryContractId p.operator aliceShares
  case optSh of
    Some sh -> sh.shares === 1000.0
    None -> abort "alice's holding not found"

  -- Alice redeems; operator settles; she gets her 1000 back, vault empties.
  redReq <- submit p.alice do
    exerciseCmd aliceShares ShareHolding_RequestRedeem
  (vault3, returned) <- submit p.operator do
    exerciseCmd redReq RedeemRequest_Accept with vaultCid = vault2
  returned === 1000.0
  optV <- queryContractId p.operator vault3
  case optV of
    Some v -> do
      v.totalShares === 0.0
      v.totalAssets === 0.0
    None -> abort "vault not found after redeem"

-- The privacy guarantee: auditor sees all, investor sees only their own,
-- an outsider sees NOTHING. This is the wedge for HackCanton judging.
testPrivacy : Script ()
testPrivacy = do
  p <- setupParties
  vault <- submit p.operator do
    createCmd Vault with
      operator = p.operator; manager = p.manager; auditor = p.auditor
      vaultId = "vault-main"; underlying = CBTC; totalAssets = 0.0; totalShares = 0.0
  depReq <- submit p.alice do
    createCmd DepositRequest with
      operator = p.operator; investor = p.alice; amount = 1000.0; vaultCid = vault
  _ <- submit p.operator do exerciseCmd depReq DepositRequest_Accept

  -- auditor: full visibility
  auditorVaults <- query @Vault p.auditor
  assertMsg "auditor sees the vault" (length auditorVaults == 1)
  auditorHoldings <- query @ShareHolding p.auditor
  assertMsg "auditor sees the holding" (length auditorHoldings == 1)

  -- alice: only her own holding
  aliceHoldings <- query @ShareHolding p.alice
  assertMsg "alice sees her holding" (length aliceHoldings == 1)

  -- mallory (outsider / counterparty): nothing at all
  mVaults <- query @Vault p.mallory
  assertMsg "outsider must NOT see the vault" (null mVaults)
  mHoldings <- query @ShareHolding p.mallory
  assertMsg "outsider must NOT see any holding" (null mHoldings)

-- THE HERO: the cash-and-carry lifecycle, on-chain. Manager proposes a
-- delta-neutral pair (short Hyperliquid perp + long cBTC spot on Canton);
-- operator approves at the oracle mark; REAL funding accrues to NAV at the
-- oracle funding feed (realized only); the sign guard unwinds both legs.
-- Privacy holds throughout (auditor sees the book, outsider sees nothing).
testRebalance : Script ()
testRebalance = do
  p <- setupParties
  vault0 <- submit p.operator do
    createCmd Vault with
      operator = p.operator; manager = p.manager; auditor = p.auditor
      vaultId = "vault-main"; underlying = CBTC; totalAssets = 1000000.0; totalShares = 1000000.0

  -- oracle publishes a cBTC mark (Chainlink ships cBTC feeds on Canton).
  feed <- submit p.oracle do
    createCmd PriceFeed with
      oracle = p.oracle; operator = p.operator; underlying = CBTC; price = 65000.0

  -- manager proposes: short BTC perp on Hyperliquid + long cBTC via Cantex,
  -- equal notional, margined by USDCx (0% — the stacked-RWA margin is next phase).
  let plan = RebalancePlan with
        underlying = CBTC; shortVenue = Hyperliquid; longVenue = Cantex
        notional = 800000.0
        collateralAsset = "USDCx"; collateralRate = 0.0
  proposal <- submit p.manager do
    exerciseCmd vault0 Vault_ProposeRebalance with plan

  -- operator approves at the oracle mark.
  posCid <- submit p.operator do
    exerciseCmd proposal RebalanceProposal_Approve with priceFeedCid = feed

  -- the position is equal-notional (net delta ≈ 0) and marked at the oracle price.
  optPos <- queryContractId p.operator posCid
  case optPos of
    Some pos -> do
      netDelta pos.longNotional pos.shortNotional === 0.0
      pos.markPrice === 65000.0
      pos.collateralAsset === "USDCx"
      pos.fundingAccrued === 0.0
    None -> abort "delta-neutral position not found after approval"

  -- update status: oracle publishes the trailing HL funding rate (14%/yr —
  -- the 3.2y HL average is ~14%); accrue a quarter of a year of REAL funding.
  -- NAV grows by 800k × 14% × 0.25 = 28k. Realized only, no phantom yield.
  fundingFeed <- submit p.oracle do
    createCmd RateFeed with
      oracle = p.oracle; operator = p.operator
      kind = Basis; asset = "BTC-PERP-HL"; annualizedRate = 0.14
  (vault1, pos1) <- submit p.operator do
    exerciseCmd vault0 Vault_AccrueFunding with
      positionCid = posCid; rateFeedCid = fundingFeed; yearFraction = 0.25
  optV <- queryContractId p.operator vault1
  case optV of
    Some v -> v.totalAssets === 1028000.0
    None -> abort "vault missing after funding accrual"
  optP1 <- queryContractId p.operator pos1
  case optP1 of
    Some pp -> pp.fundingAccrued === 28000.0
    None -> abort "position missing after funding accrual"

  -- both legs open, visible to the auditor; outsider sees nothing.
  auditorLegs <- query @VenueLeg p.auditor
  assertMsg "auditor sees both legs" (length auditorLegs == 2)
  auditorPos <- query @DeltaNeutralPosition p.auditor
  assertMsg "auditor sees the position" (length auditorPos == 1)
  mLegs <- query @VenueLeg p.mallory
  assertMsg "outsider must NOT see any leg" (null mLegs)
  mPos <- query @DeltaNeutralPosition p.mallory
  assertMsg "outsider must NOT see the position" (null mPos)

  -- fulfill: the sign guard unwinds — both legs close via the vault choice.
  submit p.operator do
    exerciseCmd vault1 Vault_UnwindPosition with positionCid = pos1
  legsAfter <- query @VenueLeg p.operator
  assertMsg "legs closed after unwind" (null legsAfter)
  posAfter <- query @DeltaNeutralPosition p.operator
  assertMsg "position closed after unwind" (null posAfter)

-- A second carry pair on cETH proves the two-asset book (BTC + ETH), each
-- pair independently sign-guarded — mirroring the production BasisYield
-- cash-carry sleeve.
testCarryTwoAssets : Script ()
testCarryTwoAssets = do
  p <- setupParties
  vault <- submit p.operator do
    createCmd Vault with
      operator = p.operator; manager = p.manager; auditor = p.auditor
      vaultId = "vault-main"; underlying = CBTC; totalAssets = 1000000.0; totalShares = 1000000.0
  btcMark <- submit p.oracle do
    createCmd PriceFeed with
      oracle = p.oracle; operator = p.operator; underlying = CBTC; price = 65000.0
  ethMark <- submit p.oracle do
    createCmd PriceFeed with
      oracle = p.oracle; operator = p.operator; underlying = CETH; price = 3200.0

  let mkPlan u = RebalancePlan with
        underlying = u; shortVenue = Hyperliquid; longVenue = Cantex
        notional = 400000.0; collateralAsset = "USDCx"; collateralRate = 0.0
  btcProp <- submit p.manager do
    exerciseCmd vault Vault_ProposeRebalance with plan = mkPlan CBTC
  ethProp <- submit p.manager do
    exerciseCmd vault Vault_ProposeRebalance with plan = mkPlan CETH
  _ <- submit p.operator do
    exerciseCmd btcProp RebalanceProposal_Approve with priceFeedCid = btcMark
  _ <- submit p.operator do
    exerciseCmd ethProp RebalanceProposal_Approve with priceFeedCid = ethMark

  -- the auditor sees the whole two-asset book; an investor none of it.
  auditorPos <- query @DeltaNeutralPosition p.auditor
  assertMsg "auditor sees both carry pairs" (length auditorPos == 2)
  alicePos <- query @DeltaNeutralPosition p.alice
  assertMsg "investor must NOT see the book" (null alicePos)

-- The RWA hero workflow: create -> update status (accrue) -> fulfill (close) ->
-- audit. Manager proposes a tokenized-Treasury repo allocation; operator
-- approves at the oracle rate; yield accrues to NAV (realized only); auditor
-- sees the full book, outsider sees nothing; close returns capital to idle NAV.
testAllocation : Script ()
testAllocation = do
  p <- setupParties
  vault0 <- submit p.operator do
    createCmd Vault with
      operator = p.operator; manager = p.manager; auditor = p.auditor
      vaultId = "vault-main"; underlying = CBTC; totalAssets = 1000000.0; totalShares = 1000000.0

  -- oracle publishes a repo rate for a tokenized 3M T-bill: 5.25%/yr.
  rate <- submit p.oracle do
    createCmd RateFeed with
      oracle = p.oracle; operator = p.operator
      kind = Repo; asset = "USTB-3M"; annualizedRate = 0.0525

  -- create: manager proposes allocating 800k to the repo source; operator approves.
  let plan = AllocationPlan with kind = Repo; asset = "USTB-3M"; principal = 800000.0
  prop <- submit p.manager do
    exerciseCmd vault0 Vault_ProposeAllocation with plan
  alloc0 <- submit p.operator do
    exerciseCmd prop AllocationProposal_Approve with rateFeedCid = rate

  -- update status: accrue one year of yield. NAV grows by 800k * 5.25% = 42k.
  (vault1, alloc1) <- submit p.operator do
    exerciseCmd vault0 Vault_AccrueAllocation with
      allocationCid = alloc0; rateFeedCid = rate; yearFraction = 1.0
  optV <- queryContractId p.operator vault1
  case optV of
    Some v -> v.totalAssets === 1042000.0   -- realized yield credited to NAV
    None -> abort "vault missing after accrual"
  optA <- queryContractId p.operator alloc1
  case optA of
    Some a -> a.accrued === 42000.0
    None -> abort "allocation missing after accrual"

  -- audit: auditor sees the allocation; investor/outsider do not.
  auditorAllocs <- query @Allocation p.auditor
  assertMsg "auditor sees the allocation" (length auditorAllocs == 1)
  aliceAllocs <- query @Allocation p.alice
  assertMsg "investor must NOT see the strategy allocation" (null aliceAllocs)
  mAllocs <- query @Allocation p.mallory
  assertMsg "outsider must NOT see any allocation" (null mAllocs)

  -- fulfill: close the allocation; realized yield already in NAV, capital idle.
  submit p.operator do
    exerciseCmd vault1 Vault_CloseAllocation with allocationCid = alloc1
  allocsAfter <- query @Allocation p.operator
  assertMsg "allocation closed after fulfill" (null allocsAfter)

-- The "transfer" step of the RWA workflow: a holder transfers their holding to
-- a new holder (propose -> accept -> operator settles). Share count unchanged;
-- privacy holds (auditor sees it, another investor / outsider sees nothing).
testTransfer : Script ()
testTransfer = do
  p <- setupParties
  vault <- submit p.operator do
    createCmd Vault with
      operator = p.operator; manager = p.manager; auditor = p.auditor
      vaultId = "vault-main"; underlying = CBTC; totalAssets = 0.0; totalShares = 0.0
  depReq <- submit p.alice do
    createCmd DepositRequest with
      operator = p.operator; investor = p.alice; amount = 1000.0; vaultCid = vault
  (_, aliceHolding) <- submit p.operator do
    exerciseCmd depReq DepositRequest_Accept

  -- propose -> accept -> settle
  prop <- submit p.alice do
    exerciseCmd aliceHolding ShareHolding_ProposeTransfer with newHolder = p.bob
  acc <- submit p.bob do
    exerciseCmd prop TransferProposal_Accept
  bobHolding <- submit p.operator do
    exerciseCmd acc AcceptedTransfer_Settle

  -- shares moved intact: alice has nothing, bob has the full holding.
  aliceH <- query @ShareHolding p.alice
  assertMsg "alice's holding is gone after transfer" (null aliceH)
  optBob <- queryContractId p.bob bobHolding
  case optBob of
    Some h -> do
      h.shares === 1000.0
      h.investor === p.bob
    None -> abort "bob's holding not found after settle"

  -- privacy: auditor sees the new holding; outsider sees nothing at any point.
  auditorH <- query @ShareHolding p.auditor
  assertMsg "auditor sees the transferred holding" (length auditorH == 1)
  mH <- query @ShareHolding p.mallory
  assertMsg "outsider must NOT see any holding" (null mH)
  mT <- query @TransferProposal p.mallory
  assertMsg "outsider must NOT see the transfer proposal" (null mT)

-- Judge-feedback fix (Grand Final): every position is BOUND to its vault.
-- A second vault — even with the same operator — cannot accrue funding on,
-- or unwind, a position it didn't open.
testVaultBinding : Script ()
testVaultBinding = do
  p <- setupParties
  vaultA <- submit p.operator do
    createCmd Vault with
      operator = p.operator; manager = p.manager; auditor = p.auditor
      vaultId = "vault-A"; underlying = CBTC; totalAssets = 1000000.0; totalShares = 1000000.0
  vaultB <- submit p.operator do
    createCmd Vault with
      operator = p.operator; manager = p.manager; auditor = p.auditor
      vaultId = "vault-B"; underlying = CBTC; totalAssets = 1000000.0; totalShares = 1000000.0

  feed <- submit p.oracle do
    createCmd PriceFeed with
      oracle = p.oracle; operator = p.operator; underlying = CBTC; price = 65000.0
  let plan = RebalancePlan with
        underlying = CBTC; shortVenue = Hyperliquid; longVenue = Cantex
        notional = 400000.0; collateralAsset = "USDCx"; collateralRate = 0.0
  prop <- submit p.manager do
    exerciseCmd vaultA Vault_ProposeRebalance with plan
  posA <- submit p.operator do
    exerciseCmd prop RebalanceProposal_Approve with priceFeedCid = feed

  fundingFeed <- submit p.oracle do
    createCmd RateFeed with
      oracle = p.oracle; operator = p.operator
      kind = Basis; asset = "BTC-PERP-HL"; annualizedRate = 0.10

  -- vault B cannot accrue vault A's position into ITS NAV...
  submitMustFail p.operator do
    exerciseCmd vaultB Vault_AccrueFunding with
      positionCid = posA; rateFeedCid = fundingFeed; yearFraction = 0.25
  -- ...nor unwind it.
  submitMustFail p.operator do
    exerciseCmd vaultB Vault_UnwindPosition with positionCid = posA

  -- vault A, the owner, can.
  _ <- submit p.operator do
    exerciseCmd vaultA Vault_AccrueFunding with
      positionCid = posA; rateFeedCid = fundingFeed; yearFraction = 0.25
  pure ()
